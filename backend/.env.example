PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/food_delivery
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
# Replace with real Stripe Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Match your Stripe account default currency (usd for US test accounts)
STRIPE_CURRENCY=usd
CLIENT_URL=http://localhost:5173
NODE_ENV=development
TAX_RATE=0.08
DEFAULT_DELIVERY_FEE=2.99
DEFAULT_ETA_MINUTES=35
