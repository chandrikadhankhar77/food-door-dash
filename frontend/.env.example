# Production Render API (for local backend use http://localhost:5000/api)
VITE_API_URL=https://backend-lhva.onrender.com/api
# Stripe test publishable key (pk_test_...) — must match backend STRIPE_PUBLISHABLE_KEY
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional: Google Maps JavaScript API key. If empty, OpenStreetMap/Leaflet is used.
VITE_GOOGLE_MAPS_API_KEY=
